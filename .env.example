# Copie este arquivo para .env.staging e .env.production (um para cada
# ambiente) e preencha com valores reais. Nunca commite .env.staging ou
# .env.production — já estão no .gitignore.

# Senha do usuário 'sa' do SQL Server no container. Requisito do SQL Server:
# mínimo 8 caracteres, com maiúscula, minúscula, número e símbolo.
SA_PASSWORD=TrocarEsta#Senha123

# Staging ou Production — controla Swagger, logging e a migração automática no startup.
ASPNETCORE_ENVIRONMENT=Staging

# Emissor e chave de assinatura do JWT. Use uma chave diferente (longa e
# aleatória) em cada ambiente — nunca a mesma do appsettings.Development.json.
JWT_ISSUER=EcoColetaApi
JWT_KEY=TrocarEstaChaveJwtPorUmaStringLongaEAleatoriaDeNoMinimo32Caracteres

# Dono do repositório no GitHub (usado para montar o nome da imagem no GHCR:
# ghcr.io/<GITHUB_REPOSITORY_OWNER>/ecocoleta-api). Em CI isso já vem
# preenchido automaticamente pelo GitHub Actions.
GITHUB_REPOSITORY_OWNER=seu-usuario-github
